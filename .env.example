# Copy this file to .env.local and fill in the values. Never commit .env.local.

# --- Supabase (Project Settings → API) ---------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Bypasses row level security. Server side only: used to close a sign-in when
# a user deletes their account. Never reference it from client code.
SUPABASE_SERVICE_ROLE_KEY=

# --- Azure AI Document Intelligence (Azure portal → your resource → Keys and Endpoint)
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=https://your-resource.cognitiveservices.azure.com
AZURE_DOCUMENT_INTELLIGENCE_KEY=

# --- Mock mode ---------------------------------------------------------------
# Set to true to replace Azure and Gemini with made-up output, for trying the
# workflow or running end-to-end tests without credentials, quota or cost.
# A banner is shown on every page while it is on. Never enable in production.
MOCK_AI=false

# --- Google Gemini (https://aistudio.google.com/apikey) ----------------------
# The free tier allows only about 20 requests a day on the current model.
GEMINI_API_KEY=

# --- End-to-end tests (npm run test:e2e) --------------------------------------
# A dedicated test account in your Supabase project. The tests create and
# delete their own job in it and run in mock mode, so they use no AI quota.
E2E_EMAIL=
E2E_PASSWORD=
# A second test account, used to prove one account cannot reach another's data.
E2E_EMAIL_2=
E2E_PASSWORD_2=
